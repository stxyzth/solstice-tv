{
  "name": "solstice-tv",
  "version": "1.0.0",
  "description": "Solstice TV — Apple TV-style Xtream Codes IPTV client for LG webOS TVs (Live TV + VOD + Series)",
  "private": true,
  "scripts": {
    "icons": "python3 scripts/gen_icons.py",
    "serve": "python3 scripts/sync_server.py",
    "package": "ares-package app -o dist",
    "install:tv": "ares-install dist/*.ipk"
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.1.0"
  }
}
